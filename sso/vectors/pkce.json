    {
      "name": "plain-method-not-supported",
      "description": "plain: the challenge equal to the verifier is rejected (S256 only).",
      "input": {
        "verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
        "challenge": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
      },
      "expected": {
        "verifierValid": true,
