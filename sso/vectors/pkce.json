        "verifier": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAb1-._~b1-._~b1-._~b1-._~b1-._~b1-._~b1-._~b1-._~b1-._~b1-._~xxxxA",
        "challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
      },
      "expected": {
        "verifierValid": false,
        "challenge": null,
        "challengeWellFormed": true,
        "verifies": false
