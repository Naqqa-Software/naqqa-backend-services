  "verify": [
    {
      "name": "current-code",
      "description": "Code of the current step.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "285532",
        "lastAcceptedStep": null
      },
      "expected": {
        "valid": true,
        "step": 58684080
      }
    },
    {
      "name": "previous-step-in-window",
      "description": "Code of the previous step, window is 1.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "465773",
        "lastAcceptedStep": null
      },
      "expected": {
        "valid": true,
        "step": 58684079
      }
    },
    {
      "name": "next-step-in-window",
      "description": "Code of the next step, window is 1.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "284041",
        "lastAcceptedStep": null
      },
      "expected": {
        "valid": true,
        "step": 58684081
      }
    },
    {
      "name": "two-steps-back-outside-window",
      "description": "Code two steps old is outside window 1.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "840485",
        "lastAcceptedStep": null
      },
      "expected": {
        "valid": false,
        "step": -1
      }
    },
    {
      "name": "two-steps-ahead-outside-window",
      "description": "Code two steps ahead is outside window 1.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "858138",
        "lastAcceptedStep": null
      },
      "expected": {
        "valid": false,
        "step": -1
      }
    },
    {
      "name": "replay-of-accepted-step",
      "description": "The same step was already accepted, so the code is refused.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "285532",
        "lastAcceptedStep": 58684080
      },
      "expected": {
        "valid": false,
        "step": -1
      }
    },
    {
      "name": "newer-than-last-accepted",
      "description": "Last accepted step is older than the code step, accepted.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
        "nowEpochSeconds": 1760522400,
        "code": "285532",
        "lastAcceptedStep": 58684079
      },
      "expected": {
        "valid": true,
        "step": 58684080
      }
    },
    {
      "name": "wrong-length",
      "description": "Five digit code for a six digit config.",
      "input": {
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30,
        "window": 1,
