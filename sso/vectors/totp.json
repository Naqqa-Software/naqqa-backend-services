  "otpauth": [
    {
      "name": "totp-basic",
      "description": "Defaults, plain issuer and account.",
      "input": {
        "type": "totp",
        "issuer": "Naqqa",
        "account": "alex@naqqa.com",
        "secretHex": "3132333435363738393031323334353637383930",
        "algorithm": "SHA1",
        "digits": 6,
        "period": 30
      },
      "expected": {
        "ok": true,
        "uri": "otpauth://totp/Naqqa:alex%40naqqa.com?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&issuer=Naqqa&algorithm=SHA1&digits=6&period=30"
      }
    },
    {
