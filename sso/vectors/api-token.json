{
  "description": "Token format: sso_<kind>_<env>_<id16>_<secret43>_<crc6>. Kind pk or sk, env live or test, id and secret Base62. crc is CRC-32 (IEEE, as unsigned integer) of the ASCII text before the last underscore, written as 6 Base62 digits, most significant first, alphabet 0-9A-Za-z. Total length is 91. input.tokenBase64 and expected.secret are standard Base64 of the ASCII text, so that secret scanners do not mistake these test vectors for live keys.",
  "version": 1,
  "length": 79,
  "cases": [
    {
      "name": "valid-secret-live",
      "description": "Secret key, live environment.",
      "input": {
        "tokenBase64": "c3NvX3NrX2xpdmVfR05VYmlwdzNBSE9WY2pxeF9UYWhvdjI5R05VYmlwdzNBSE9WY2pxeDRCSVBXZGtyeTVDSlFYZWxzejZEXzJlOWVTSA=="
      },
      "expected": {
        "valid": true,
        "kind": "sk",
        "env": "live",
        "id": "GNUbipw3AHOVcjqx",
        "secret": "VGFob3YyOUdOVWJpcHczQUhPVmNqcXg0QklQV2Rrcnk1Q0pRWGVsc3o2RA=="
      }
    },
    {
      "name": "valid-secret-test",
      "description": "Secret key, test environment.",
