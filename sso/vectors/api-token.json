        "tokenBase64": "c3NvX3NrX3Rlc3RfZ251MThGTVRhaG92MjlHTl90MDdFTFNaZ251MThGTVRhaG92MjlHTlViaXB3M0FIT1ZjanF4NEJJUFdkXzNESlI2Tw=="
      },
      "expected": {
        "valid": true,
        "kind": "sk",
        "env": "test",
        "id": "gnu18FMTahov29GN",
        "secret": "dDA3RUxTWmdudTE4Rk1UYWhvdjI5R05VYmlwdzNBSE9WY2pxeDRCSVBXZA=="
      }
    },
