  "cases": [
    {
      "name": "verify-default-iterations",
      "description": "Hash at the default 210000 iterations, policy 210000.",
      "input": {
        "password": "correct horse battery staple 9!",
        "pepperHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
        "policyIterations": 210000,
        "hash": "$pbkdf2-sha512$v=1$i=210000$rcWR2gD5hJY1Qh1VrDaO1g$xWxZKh43oTDdyaxd47KNw0nvEBonCTSa9Jd7mlJrIBoEPhCoAqSKQqOQ67P654qxNIXNJfaSrf3eHqzt2DvWwA"
      },
      "expected": {
        "verifies": true,
        "needsRehash": false,
        "parsed": {
          "iterations": 210000,
          "saltHex": "adc591da00f9849635421d55ac368ed6",
          "hashHex": "c56c592a1e37a130ddc9ac5de3b28dc349ef101a2709349af4977b9a526b201a043e10a802a48a42a390ebb3fae78ab13485cd25f692adfdde1eacedd83bd6c0"
        }
      }
    },
